# ── Database ──────────────────────────────
DB_NAME=image_upload
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=55432

# ── Redis ─────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── AWS S3 ────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# AWS_ENDPOINT=   # only for S3-compatible stores such as MinIO

# ── Server ────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── Tunables (defaults shown) ─────────────
# MAX_FILE_MB=25
# MIN_FILE_KB=30
# MIN_WIDTH=512
# MIN_HEIGHT=512
# BLUR_THRESHOLD=100
# MIN_FACE_RATIO=0.05
# SIMILARITY_DISTANCE=24
# WORKER_CONCURRENCY=1
